{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões mínimas: diálogos de arquivo (SFTP) e abertura de editor externo.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "opener:allow-open-path",
    "opener:allow-open-url",
    "opener:allow-default-urls"
  ]
}
